# =============================================================================
# Annapurna ML - Git Ignore Rules for ml_pipeline Subdirectory
# =============================================================================

# 1. Cache folders & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.cache/

# 2. Training datasets, data caches, and CSV/Parquet files
*.csv
*.parquet
*.npy
*.npz
features_cache/
**/features_cache/

# 3. Experiment runs, temporary weights, and training runs
runs/
**/runs/
**/runs2/
resume_roundtrip.pt

# 4. Reports, temporary logs, and evaluation metrics outputs
reports/
**/reports/
registry/reports/
run_all_summary.json
eval_report.json
eval_history.json
history.json
run_state.json
run.json
*.log

# 5. Training, data generation, benchmarking, and test scripts
ml_*_train*.py
ml_anomaly_train_sih2026.py
ml_demand_train.py
ml_demand_train_sih2026.py
ml_quality_train_sih2026.py
ml_cv_train_cls.py
ml_cv_train_food.py
ml_cv_bakeoff.py
ml_cv_dino_probe.py
ml_cv_prepare_data.py
ml_cv_prepare_food_data.py
ml_data_gen_*.py
ml_data_load_*.py
generate_annapurna_data.py
validate_annapurna_data.py
ml_validate_sih2026.py
ml_report_metrics.py
ml_cv_eval_report.py
ml_logistics_benchmark.py
ml_logistics_bench_sih2026.py
ml_tests_*.py
ml_run_all.py
CONTINUE_TRAINING.sh
_*.py

# 6. Whitelist / Exceptions for Serving & Model Artifacts
!ml_quality_train_fusion.py
!ml_quality_train_shelf_life.py
!registry/models/**/*.joblib
!registry/models/**/*.json
!ml_requirements*.txt

