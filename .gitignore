# =============================================================================
# Annapurna ML - Production Serving .gitignore
# =============================================================================

# Ignore everything by default
/*

# Root files to track
!.gitignore
!README.md

# Allow ml_pipeline directory
!ml_pipeline/

# Inside ml_pipeline, ignore everything by default
ml_pipeline/*

# 1. Whitelist Python inference files
!ml_pipeline/ml_demand_features.py
!ml_pipeline/ml_demand_model.py
!ml_pipeline/ml_quality_inference.py
!ml_pipeline/ml_quality_time_temp.py
!ml_pipeline/ml_analytics_processing_anomaly.py
!ml_pipeline/ml_analytics_sustainability.py
!ml_pipeline/ml_logistics_match.py
!ml_pipeline/ml_logistics_route.py
!ml_pipeline/ml_utils.py
!ml_pipeline/ml_device.py

# 2. Whitelist Model registry
!ml_pipeline/registry/
!ml_pipeline/registry/models/
!ml_pipeline/registry/models/**

# 3. Whitelist Configurations and dependencies
!ml_pipeline/ml_configs_fusion.yaml
!ml_pipeline/ml_configs_sustainability.yaml
!ml_pipeline/ml_requirements.txt

# =============================================================================
# Explicit Exclusions (Never Track)
# =============================================================================
# Training datasets & CSV/Parquet files
*.csv
*.parquet
*.npy
*.npz

# Experiment runs, checkpoints, and temporary outputs
runs/
**/runs/
**/runs2/
*.pt
resume_roundtrip.pt
reports/
**/reports/

# Cache folders & Virtual Environments
__pycache__/
**/__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.DS_Store
